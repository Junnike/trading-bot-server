# /etc/kalshi_bot.env  (chmod 600). Trading key: create at kalshi.com -> API keys; save the private key PEM on the droplet.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/kalshi_bot.pem
BOT_LOG_DIR=/var/lib/kalshi_bot
SERIES=KXBTC15M
SYMBOL=BTCUSDT
COUNT=20
CRSI_MAX=20
HS_MIN=0
LAT=2
FILL_WAIT=20
MAX_DAILY_LOSS_USD=30
MAX_OPEN=4
KILL_FILE=/var/lib/kalshi_bot/KILL
